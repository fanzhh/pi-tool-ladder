{
  "name": "pi-tool-ladder",
  "version": "0.1.0",
  "description": "Keep Pi's tool schemas out of the prompt until they are actually needed: category -> subset -> on-demand mounting, under a hard tool/character budget. Built for running Pi agents on small local models.",
  "type": "module",
  "license": "MIT",
  "author": "fanzhh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fanzhh/pi-tool-ladder.git"
  },
  "homepage": "https://github.com/fanzhh/pi-tool-ladder",
  "keywords": [
    "pi",
    "pi-coding-agent",
    "agent",
    "coding-agent",
    "tools",
    "prompt",
    "context",
    "local-llm",
    "ollama",
    "extension"
  ],
  "scripts": {
    "e2e": "bash e2e/run.sh",
    "eval:offline": "node --experimental-strip-types eval/offline-eval.ts",
    "eval:ab": "bash eval/ab-local.sh",
    "eval:misroute": "bash eval/misroute.sh"
  },
  "dependencies": {
    "typebox": "^1.4.0"
  }
}
